{
  "name": "multiagentsystem",
  "displayName": "Multiagent System",
  "description": "Native terminal prototype for coordinating CLI coding agents in VS Code.",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onCommand:multiagentSystem.openTerminalGroup",
    "onCommand:multiagentSystem.launchAgent",
    "onCommand:multiagentSystem.worktrees.list",
    "onCommand:multiagentSystem.worktrees.create",
    "onCommand:multiagentSystem.worktrees.remove",
    "onCommand:multiagentSystem.github.browse",
    "onCommand:multiagentSystem.github.openIssue",
    "onCommand:multiagentSystem.github.openPullRequest",
    "onCommand:multiagentSystem.github.openChecks",
    "onCommand:multiagentSystem.github.pullRequestStatus",
    "onCommand:multiagentSystem.github.signIn",
    "onCommand:multiagentSystem.github.refreshView",
    "onCommand:multiagentSystem.github.openInEditor",
    "onView:multiagentSystem.githubView",
    "onCommand:multiagentSystem.accounts.refresh",
    "onCommand:multiagentSystem.accounts.create",
    "onCommand:multiagentSystem.accounts.details",
    "onCommand:multiagentSystem.accounts.edit",
    "onCommand:multiagentSystem.accounts.remove",
    "onCommand:multiagentSystem.accounts.login",
    "onCommand:multiagentSystem.accounts.launch",
    "onView:multiagentSystem.accountsView",
    "onCommand:multiagentSystem.roles.refresh",
    "onCommand:multiagentSystem.roles.create",
    "onCommand:multiagentSystem.roles.edit",
    "onCommand:multiagentSystem.roles.preview",
    "onCommand:multiagentSystem.roles.remove",
    "onView:multiagentSystem.rolesView",
    "onCommand:multiagentSystem.sessions.list",
    "onCommand:multiagentSystem.storage.status"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "multiagentSystem.githubView",
          "name": "Multiagent GitHub"
        },
        { "id": "multiagentSystem.accountsView", "name": "Accounts and Sessions" },
        { "id": "multiagentSystem.rolesView", "name": "Role Groups and Rules" }
      ]
    },
    "commands": [
      {
        "command": "multiagentSystem.openTerminalGroup",
        "title": "Multiagent: Open Four Native Terminals"
      },
      {
        "command": "multiagentSystem.launchAgent",
        "title": "Multiagent: Launch CLI Agent in Native Terminal"
      },
      {
        "command": "multiagentSystem.worktrees.list",
        "title": "Multiagent: List and Open Worktrees"
      },
      {
        "command": "multiagentSystem.worktrees.create",
        "title": "Multiagent: Create Worktree"
      },
      {
        "command": "multiagentSystem.worktrees.remove",
        "title": "Multiagent: Release Worktree"
      },
      {
        "command": "multiagentSystem.github.browse",
        "title": "Multiagent: Browse GitHub Issues and Pull Requests"
      },
      {
        "command": "multiagentSystem.github.openIssue",
        "title": "Multiagent: Open GitHub Issue"
      },
      {
        "command": "multiagentSystem.github.openPullRequest",
        "title": "Multiagent: Open GitHub Pull Request"
      },
      {
        "command": "multiagentSystem.github.openChecks",
        "title": "Multiagent: Open GitHub Pull Request Checks"
      },
      {
        "command": "multiagentSystem.github.pullRequestStatus",
        "title": "Multiagent: Show GitHub Pull Request Review and CI Status"
      },
      {
        "command": "multiagentSystem.github.signIn",
        "title": "Multiagent: Sign In to GitHub"
      },
      {
        "command": "multiagentSystem.github.refreshView",
        "title": "Multiagent: Refresh GitHub View",
        "icon": "$(refresh)"
      },
      {
        "command": "multiagentSystem.github.openInEditor",
        "title": "Multiagent: Open GitHub Item in Editor"
      },
      { "command": "multiagentSystem.accounts.refresh", "title": "Multiagent: Refresh Accounts", "icon": "$(refresh)" },
      { "command": "multiagentSystem.accounts.create", "title": "Multiagent: Create Account Profile", "icon": "$(add)" },
      { "command": "multiagentSystem.accounts.details", "title": "Multiagent: Show Account Details" },
      { "command": "multiagentSystem.accounts.edit", "title": "Multiagent: Edit Account Profile" },
      { "command": "multiagentSystem.accounts.remove", "title": "Multiagent: Remove Account Profile" },
      { "command": "multiagentSystem.accounts.login", "title": "Multiagent: Sign In to Account" },
      { "command": "multiagentSystem.accounts.launch", "title": "Multiagent: Start Session with Account" },
      { "command": "multiagentSystem.roles.refresh", "title": "Multiagent: Refresh Role Groups", "icon": "$(refresh)" },
      { "command": "multiagentSystem.roles.create", "title": "Multiagent: Create Role Group", "icon": "$(add)" },
      { "command": "multiagentSystem.roles.edit", "title": "Multiagent: Edit Role Group" },
      { "command": "multiagentSystem.roles.preview", "title": "Multiagent: Preview Effective Rules" },
      { "command": "multiagentSystem.roles.remove", "title": "Multiagent: Remove Role Group" },
      {
        "command": "multiagentSystem.storage.status",
        "title": "Multiagent: Show Private Storage Status"
      },
      {
        "command": "multiagentSystem.sessions.list",
        "title": "Multiagent: Sessions"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "multiagentSystem.github.refreshView",
          "when": "view == multiagentSystem.githubView",
          "group": "navigation"
        },
        { "command": "multiagentSystem.accounts.create", "when": "view == multiagentSystem.accountsView", "group": "navigation" },
        { "command": "multiagentSystem.accounts.refresh", "when": "view == multiagentSystem.accountsView", "group": "navigation" },
        { "command": "multiagentSystem.roles.create", "when": "view == multiagentSystem.rolesView", "group": "navigation" },
        { "command": "multiagentSystem.roles.refresh", "when": "view == multiagentSystem.rolesView", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "multiagentSystem.accounts.login", "when": "view == multiagentSystem.accountsView && viewItem == multiagentAccountProfile", "group": "inline" },
        { "command": "multiagentSystem.accounts.launch", "when": "view == multiagentSystem.accountsView && viewItem == multiagentAccountProfile", "group": "inline@2" },
        { "command": "multiagentSystem.accounts.edit", "when": "view == multiagentSystem.accountsView && viewItem == multiagentAccountProfile", "group": "management" },
        { "command": "multiagentSystem.accounts.remove", "when": "view == multiagentSystem.accountsView && viewItem == multiagentAccountProfile", "group": "management" },
        { "command": "multiagentSystem.roles.preview", "when": "view == multiagentSystem.rolesView && viewItem == multiagentRoleGroup", "group": "inline" },
        { "command": "multiagentSystem.roles.edit", "when": "view == multiagentSystem.rolesView && viewItem == multiagentRoleGroup", "group": "management" },
        { "command": "multiagentSystem.roles.remove", "when": "view == multiagentSystem.rolesView && viewItem == multiagentRoleGroup", "group": "management" }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test:unit": "npm run build && node --test \"test/**/*.test.js\" \"out/test/unit/**/*.test.js\"",
    "test:host": "npm run build && node out/test/host/runTest.js",
    "test": "npm run check && npm run test:unit",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "typescript": "7.0.2"
  }
}
