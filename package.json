{
  "name": "multiagentsystem",
  "displayName": "Multiagent System",
  "description": "Native terminal prototype for coordinating CLI coding agents in VS Code.",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onCommand:multiagentSystem.openTerminalGroup",
    "onCommand:multiagentSystem.launchAgent",
    "onCommand:multiagentSystem.worktrees.list",
    "onCommand:multiagentSystem.worktrees.create",
    "onCommand:multiagentSystem.worktrees.remove",
    "onCommand:multiagentSystem.github.browse",
    "onCommand:multiagentSystem.github.openIssue",
    "onCommand:multiagentSystem.github.openPullRequest",
    "onCommand:multiagentSystem.github.openChecks",
    "onCommand:multiagentSystem.github.pullRequestStatus",
    "onCommand:multiagentSystem.github.signIn",
    "onCommand:multiagentSystem.github.refreshView",
    "onCommand:multiagentSystem.github.openInEditor",
    "onView:multiagentSystem.githubView",
    "onView:multiagentSystem.overviewView",
    "onView:multiagentSystem.issuesReportView",
    "onView:multiagentSystem.prsReportView",
    "onCommand:multiagentSystem.reports.refresh",
    "onCommand:multiagentSystem.reports.feedback",
    "onCommand:multiagentSystem.reports.publicFeedback",
    "onCommand:multiagentSystem.reports.reviewPullRequest",
    "onCommand:multiagentSystem.reports.mergePullRequest",
    "onCommand:multiagentSystem.reports.configurePublisher",
    "onCommand:multiagentSystem.reports.configureMergeAuthority",
    "onCommand:multiagentSystem.reports.backToList",
    "onCommand:multiagentSystem.reports.showDiff",
    "onCommand:multiagentSystem.overview.refresh",
    "onView:multiagentSystem.planView",
    "onCommand:multiagentSystem.plan.open",
    "onCommand:multiagentSystem.plan.create",
    "onCommand:multiagentSystem.plan.refresh",
    "onCommand:multiagentSystem.plan.filter",
    "onCommand:multiagentSystem.plan.returnToOverview",
    "onCommand:multiagentSystem.accounts.refresh",
    "onCommand:multiagentSystem.accounts.create",
    "onCommand:multiagentSystem.accounts.details",
    "onCommand:multiagentSystem.accounts.edit",
    "onCommand:multiagentSystem.accounts.remove",
    "onCommand:multiagentSystem.accounts.login",
    "onCommand:multiagentSystem.accounts.check",
    "onCommand:multiagentSystem.accounts.limits",
    "onCommand:multiagentSystem.accounts.launch",
    "onView:multiagentSystem.accountsView",
    "onCommand:multiagentSystem.roles.refresh",
    "onCommand:multiagentSystem.roles.create",
    "onCommand:multiagentSystem.roles.edit",
    "onCommand:multiagentSystem.roles.preview",
    "onCommand:multiagentSystem.roles.start",
    "onCommand:multiagentSystem.roles.remove",
    "onView:multiagentSystem.rolesView",
    "onCommand:multiagentSystem.broadcasts.refresh",
    "onCommand:multiagentSystem.broadcasts.send",
    "onCommand:multiagentSystem.broadcasts.revoke",
    "onView:multiagentSystem.broadcastsView",
    "onView:multiagentSystem.toolsSetupView",
    "onCommand:multiagentSystem.setup.refresh",
    "onCommand:multiagentSystem.setup.retryGh",
    "onCommand:multiagentSystem.setup.retryCodex",
    "onCommand:multiagentSystem.setup.diagnose",
    "onCommand:multiagentSystem.setup.migrateStorage",
    "onCommand:multiagentSystem.setup.recoverStorageLock",
    "onCommand:multiagentSystem.setup.clearStorage",
    "onCommand:multiagentSystem.sessions.list",
    "onCommand:multiagentSystem.storage.status"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "multiagentSystem", "title": "Multiagent", "icon": "media/multiagent.svg" }
      ]
    },
    "views": {
      "multiagentSystem": [
        { "id": "multiagentSystem.overviewView", "name": "Overview" },
        { "id": "multiagentSystem.planView", "name": "Core Plan" },
        { "id": "multiagentSystem.issuesReportView", "name": "Issues Report" },
        { "id": "multiagentSystem.prsReportView", "name": "PRs Report" },
        { "id": "multiagentSystem.githubView", "name": "GitHub" },
        { "id": "multiagentSystem.accountsView", "name": "Accounts and Sessions" },
        { "id": "multiagentSystem.rolesView", "name": "Role Groups and Rules" },
        { "id": "multiagentSystem.broadcastsView", "name": "Administrator Broadcasts" },
        { "id": "multiagentSystem.toolsSetupView", "name": "Tools Setup" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "multiagentSystem.overviewView",
        "contents": "No agents yet. Nothing here is running until you start it.\n[Create Account](command:multiagentSystem.accounts.create)\n[Create Role Group](command:multiagentSystem.roles.create)\n[Open Four Native Terminals](command:multiagentSystem.openTerminalGroup)"
      },
      {
        "view": "multiagentSystem.planView",
        "contents": "This project has no core plan yet. Create docs/MASTER_PLAN.md, then add numbered TODOs.\n[Create Core Plan](command:multiagentSystem.plan.create)\n[Refresh](command:multiagentSystem.plan.refresh)"
      },
      {
        "view": "multiagentSystem.issuesReportView",
        "contents": "No Issues to read. Open a project folder that has a GitHub origin and sign in to GitHub.\n[Sign In to GitHub](command:multiagentSystem.github.signIn)\n[Refresh](command:multiagentSystem.reports.refresh)"
      },
      {
        "view": "multiagentSystem.prsReportView",
        "contents": "No pull requests to read. Open a project folder that has a GitHub origin and sign in to GitHub.\n[Sign In to GitHub](command:multiagentSystem.github.signIn)\n[Refresh](command:multiagentSystem.reports.refresh)"
      },
      {
        "view": "multiagentSystem.githubView",
        "contents": "No GitHub items to show. Sign in, or open a project that has a GitHub remote.\n[Sign In to GitHub](command:multiagentSystem.github.signIn)\n[Refresh](command:multiagentSystem.github.refreshView)"
      },
      {
        "view": "multiagentSystem.accountsView",
        "contents": "No account profiles yet. An account says which CLI sign-in an agent uses.\n[Create Account](command:multiagentSystem.accounts.create)"
      },
      {
        "view": "multiagentSystem.rolesView",
        "contents": "No role groups yet. A role group says what an agent may do.\n[Create Role Group](command:multiagentSystem.roles.create)"
      },
      {
        "view": "multiagentSystem.broadcastsView",
        "contents": "Local broadcast notices are stored on this computer and shown in matching role previews. Session launch and CLI delivery are not connected.\n[Create Broadcast Notice](command:multiagentSystem.broadcasts.send)"
      },
      {
        "view": "multiagentSystem.toolsSetupView",
        "contents": "Tool status has not been read yet. Missing or unverified tools never count as ready.\n[Refresh](command:multiagentSystem.setup.refresh)"
      }
    ],
    "commands": [
      {
        "command": "multiagentSystem.openTerminalGroup",
        "title": "Multiagent: Open Four Native Terminals"
      },
      {
        "command": "multiagentSystem.launchAgent",
        "title": "Multiagent: Launch CLI Agent in Native Terminal"
      },
      {
        "command": "multiagentSystem.setup.refresh",
        "title": "Multiagent: Refresh Tools Setup",
        "icon": "$(refresh)"
      },
      {
        "command": "multiagentSystem.setup.retryGh",
        "title": "Multiagent: Retry Verified GitHub CLI Setup",
        "icon": "$(cloud-download)"
      },
      {
        "command": "multiagentSystem.setup.retryCodex",
        "title": "Multiagent: Retry Verified Codex CLI Setup",
        "icon": "$(cloud-download)"
      },
      {
        "command": "multiagentSystem.setup.diagnose",
        "title": "Multiagent: Open Masked Setup and Storage Diagnostics",
        "icon": "$(pulse)"
      },
      {
        "command": "multiagentSystem.setup.migrateStorage",
        "title": "Multiagent: Migrate Private Storage Schema"
      },
      {
        "command": "multiagentSystem.setup.recoverStorageLock",
        "title": "Multiagent: Recover Stale Private Storage Lock"
      },
      {
        "command": "multiagentSystem.setup.clearStorage",
        "title": "Multiagent: Clear Private Storage Data"
      },
      {
        "command": "multiagentSystem.worktrees.list",
        "title": "Multiagent: List and Open Worktrees"
      },
      {
        "command": "multiagentSystem.worktrees.create",
        "title": "Multiagent: Create Worktree"
      },
      {
        "command": "multiagentSystem.worktrees.remove",
        "title": "Multiagent: Release Worktree"
      },
      {
        "command": "multiagentSystem.github.browse",
        "title": "Multiagent: Browse GitHub Issues and Pull Requests"
      },
      {
        "command": "multiagentSystem.github.openIssue",
        "title": "Multiagent: Open GitHub Issue"
      },
      {
        "command": "multiagentSystem.github.openPullRequest",
        "title": "Multiagent: Open GitHub Pull Request"
      },
      {
        "command": "multiagentSystem.github.openChecks",
        "title": "Multiagent: Open GitHub Pull Request Checks"
      },
      {
        "command": "multiagentSystem.github.pullRequestStatus",
        "title": "Multiagent: Show GitHub Pull Request Review and CI Status"
      },
      {
        "command": "multiagentSystem.github.signIn",
        "title": "Multiagent: Sign In to GitHub"
      },
      {
        "command": "multiagentSystem.github.refreshView",
        "title": "Multiagent: Refresh GitHub View",
        "icon": "$(refresh)"
      },
      {
        "command": "multiagentSystem.github.openInEditor",
        "title": "Multiagent: Open GitHub Item in Editor"
      },
      { "command": "multiagentSystem.overview.refresh", "title": "Multiagent: Refresh Overview", "icon": "$(refresh)" },
      { "command": "multiagentSystem.plan.open", "title": "Multiagent: Open Core Plan" },
      { "command": "multiagentSystem.plan.create", "title": "Multiagent: Create Core Plan", "icon": "$(add)" },
      { "command": "multiagentSystem.plan.refresh", "title": "Multiagent: Refresh Core Plan", "icon": "$(refresh)" },
      { "command": "multiagentSystem.plan.filter", "title": "Multiagent: Filter Core Plan TODOs", "icon": "$(filter)" },
      { "command": "multiagentSystem.plan.returnToOverview", "title": "Multiagent: Return to Agent Overview", "icon": "$(arrow-left)" },
      { "command": "multiagentSystem.overview.openPullRequest", "title": "Multiagent: Open This Agent's Pull Request on GitHub", "icon": "$(git-pull-request)" },
      { "command": "multiagentSystem.reports.open", "title": "Multiagent: Read Report" },
      { "command": "multiagentSystem.reports.next", "title": "Multiagent: Next Report", "icon": "$(arrow-down)" },
      { "command": "multiagentSystem.reports.previous", "title": "Multiagent: Previous Report", "icon": "$(arrow-up)" },
      { "command": "multiagentSystem.reports.backToOverview", "title": "Multiagent: Back to Agent Overview", "icon": "$(home)" },
      { "command": "multiagentSystem.reports.backToList", "title": "Multiagent: Back to Report List", "icon": "$(list-tree)" },
      { "command": "multiagentSystem.reports.showDiff", "title": "Multiagent: Show Changed Files and Diff", "icon": "$(diff)" },
      { "command": "multiagentSystem.reports.refresh", "title": "Multiagent: Refresh Reports", "icon": "$(refresh)" },
      { "command": "multiagentSystem.reports.feedback", "title": "Multiagent: Save Local Feedback on Report", "icon": "$(edit)" },
      { "command": "multiagentSystem.reports.publicFeedback", "title": "Multiagent: Publish Feedback for Open Report", "icon": "$(comment-discussion)" },
      { "command": "multiagentSystem.reports.reviewPullRequest", "title": "Multiagent: Submit Formal Pull Request Review", "icon": "$(check)" },
      { "command": "multiagentSystem.reports.mergePullRequest", "title": "Multiagent: Merge Pull Request from Report", "icon": "$(git-merge)" },
      { "command": "multiagentSystem.reports.configurePublisher", "title": "Multiagent: Configure Public Feedback Publisher" },
      { "command": "multiagentSystem.reports.configureMergeAuthority", "title": "Multiagent: Configure Pull Request Merge Authority" },
      { "command": "multiagentSystem.accounts.refresh", "title": "Multiagent: Refresh Accounts", "icon": "$(refresh)" },
      { "command": "multiagentSystem.accounts.create", "title": "Multiagent: Create Account Profile", "icon": "$(add)" },
      { "command": "multiagentSystem.accounts.details", "title": "Multiagent: Show Account Details" },
      { "command": "multiagentSystem.accounts.edit", "title": "Multiagent: Edit Account Profile" },
      { "command": "multiagentSystem.accounts.remove", "title": "Multiagent: Remove Account Profile" },
      { "command": "multiagentSystem.accounts.login", "title": "Multiagent: Sign In to Account" },
      { "command": "multiagentSystem.accounts.check", "title": "Multiagent: Check Account Sign-in", "icon": "$(verified)" },
      { "command": "multiagentSystem.accounts.limits", "title": "Multiagent: Set Account Limits", "icon": "$(dashboard)" },
      { "command": "multiagentSystem.accounts.launch", "title": "Multiagent: Start Session with Account" },
      { "command": "multiagentSystem.roles.refresh", "title": "Multiagent: Refresh Role Groups", "icon": "$(refresh)" },
      { "command": "multiagentSystem.roles.create", "title": "Multiagent: Create Role Group", "icon": "$(add)" },
      { "command": "multiagentSystem.roles.edit", "title": "Multiagent: Edit Role Group" },
      { "command": "multiagentSystem.roles.start", "title": "Multiagent: Start Agent with This Role Group", "icon": "$(play)" },
      { "command": "multiagentSystem.roles.preview", "title": "Multiagent: Preview Effective Rules" },
      { "command": "multiagentSystem.roles.remove", "title": "Multiagent: Remove Role Group" },
      { "command": "multiagentSystem.broadcasts.refresh", "title": "Multiagent: Refresh Broadcasts", "icon": "$(refresh)" },
      { "command": "multiagentSystem.broadcasts.send", "title": "Multiagent: Create Broadcast Notice", "icon": "$(megaphone)" },
      { "command": "multiagentSystem.broadcasts.details", "title": "Multiagent: Read Full Broadcast Notice" },
      { "command": "multiagentSystem.broadcasts.revoke", "title": "Multiagent: Revoke Broadcast" },
      {
        "command": "multiagentSystem.storage.status",
        "title": "Multiagent: Show Private Storage Status"
      },
      {
        "command": "multiagentSystem.sessions.list",
        "title": "Multiagent: Sessions"
      },
      { "command": "multiagentSystem.sessions.focus", "title": "Multiagent: Focus Session Terminal", "icon": "$(eye)" },
      { "command": "multiagentSystem.sessions.stop", "title": "Multiagent: Stop Session Terminal", "icon": "$(debug-stop)" },
      { "command": "multiagentSystem.sessions.reopen", "title": "Multiagent: Reopen Session in a New Terminal", "icon": "$(debug-restart)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "multiagentSystem.reports.backToOverview", "when": "resourceScheme == multiagent-report", "group": "navigation@0" },
        { "command": "multiagentSystem.reports.backToList", "when": "resourceScheme == multiagent-report", "group": "navigation" },
        { "command": "multiagentSystem.reports.showDiff", "when": "resourceScheme == multiagent-report && resourcePath =~ /pull-request-/", "group": "navigation" },
        { "command": "multiagentSystem.reports.previous", "when": "resourceScheme == multiagent-report", "group": "navigation@1" },
        { "command": "multiagentSystem.reports.next", "when": "resourceScheme == multiagent-report", "group": "navigation@2" },
        { "command": "multiagentSystem.reports.feedback", "when": "resourceScheme == multiagent-report", "group": "navigation@3" },
        { "command": "multiagentSystem.reports.publicFeedback", "when": "resourceScheme == multiagent-report", "group": "navigation@4" },
        { "command": "multiagentSystem.reports.reviewPullRequest", "when": "resourceScheme == multiagent-report && resourcePath =~ /pull-request-/", "group": "navigation@5" },
        { "command": "multiagentSystem.reports.mergePullRequest", "when": "resourceScheme == multiagent-report && resourcePath =~ /pull-request-/", "group": "navigation@6" }
      ],
      "view/title": [
        { "command": "multiagentSystem.reports.refresh", "when": "view == multiagentSystem.issuesReportView || view == multiagentSystem.prsReportView", "group": "navigation" },
        { "command": "multiagentSystem.overview.refresh", "when": "view == multiagentSystem.overviewView", "group": "navigation" },
        { "command": "multiagentSystem.plan.create", "when": "view == multiagentSystem.planView", "group": "navigation@1" },
        { "command": "multiagentSystem.plan.refresh", "when": "view == multiagentSystem.planView", "group": "navigation@2" },
        { "command": "multiagentSystem.plan.filter", "when": "view == multiagentSystem.planView", "group": "navigation@3" },
        { "command": "multiagentSystem.plan.returnToOverview", "when": "view == multiagentSystem.planView", "group": "navigation@4" },
        {
          "command": "multiagentSystem.github.refreshView",
          "when": "view == multiagentSystem.githubView",
          "group": "navigation"
        },
        { "command": "multiagentSystem.accounts.create", "when": "view == multiagentSystem.accountsView", "group": "navigation" },
        { "command": "multiagentSystem.accounts.refresh", "when": "view == multiagentSystem.accountsView", "group": "navigation" },
        { "command": "multiagentSystem.roles.create", "when": "view == multiagentSystem.rolesView", "group": "navigation" },
        { "command": "multiagentSystem.roles.refresh", "when": "view == multiagentSystem.rolesView", "group": "navigation" },
        { "command": "multiagentSystem.broadcasts.send", "when": "view == multiagentSystem.broadcastsView", "group": "navigation" },
        { "command": "multiagentSystem.broadcasts.refresh", "when": "view == multiagentSystem.broadcastsView", "group": "navigation" },
        { "command": "multiagentSystem.setup.diagnose", "when": "view == multiagentSystem.toolsSetupView", "group": "navigation@1" },
        { "command": "multiagentSystem.setup.refresh", "when": "view == multiagentSystem.toolsSetupView", "group": "navigation@2" },
        { "command": "multiagentSystem.setup.migrateStorage", "when": "view == multiagentSystem.toolsSetupView", "group": "maintenance@1" },
        { "command": "multiagentSystem.setup.recoverStorageLock", "when": "view == multiagentSystem.toolsSetupView", "group": "maintenance@2" },
        { "command": "multiagentSystem.setup.clearStorage", "when": "view == multiagentSystem.toolsSetupView", "group": "maintenance@3" }
      ],
      "view/item/context": [
        { "command": "multiagentSystem.overview.openPullRequest", "when": "view == multiagentSystem.overviewView && viewItem =~ /^multiagentOverviewAgent(Live|Closed)Pr$/", "group": "inline@0" },
        { "command": "multiagentSystem.sessions.focus", "when": "view == multiagentSystem.overviewView && viewItem =~ /^multiagentOverviewAgentLive/", "group": "inline@1" },
        { "command": "multiagentSystem.sessions.stop", "when": "view == multiagentSystem.overviewView && viewItem =~ /^multiagentOverviewAgentLive/", "group": "inline@2" },
        { "command": "multiagentSystem.sessions.reopen", "when": "view == multiagentSystem.overviewView && viewItem =~ /^multiagentOverviewAgentClosed/", "group": "inline" },
        { "command": "multiagentSystem.accounts.login", "when": "view == multiagentSystem.accountsView && viewItem == multiagentAccountProfile", "group": "inline" },
        { "command": "multiagentSystem.accounts.check", "when": "view == multiagentSystem.accountsView && viewItem == multiagentAccountProfile", "group": "inline@2" },
        { "command": "multiagentSystem.accounts.launch", "when": "view == multiagentSystem.accountsView && viewItem == multiagentAccountProfile", "group": "inline@3" },
        { "command": "multiagentSystem.accounts.limits", "when": "view == multiagentSystem.accountsView && viewItem == multiagentAccountProfile", "group": "management@0" },
        { "command": "multiagentSystem.accounts.edit", "when": "view == multiagentSystem.accountsView && viewItem == multiagentAccountProfile", "group": "management" },
        { "command": "multiagentSystem.accounts.remove", "when": "view == multiagentSystem.accountsView && viewItem == multiagentAccountProfile", "group": "management" },
        { "command": "multiagentSystem.roles.start", "when": "view == multiagentSystem.rolesView && viewItem == multiagentRoleGroup", "group": "inline@0" },
        { "command": "multiagentSystem.roles.preview", "when": "view == multiagentSystem.rolesView && viewItem == multiagentRoleGroup", "group": "inline@1" },
        { "command": "multiagentSystem.roles.edit", "when": "view == multiagentSystem.rolesView && viewItem == multiagentRoleGroup", "group": "management" },
        { "command": "multiagentSystem.roles.remove", "when": "view == multiagentSystem.rolesView && viewItem == multiagentRoleGroup", "group": "management" },
        { "command": "multiagentSystem.broadcasts.revoke", "when": "view == multiagentSystem.broadcastsView && viewItem == multiagentBroadcastActive", "group": "inline" },
        { "command": "multiagentSystem.setup.retryGh", "when": "view == multiagentSystem.toolsSetupView && viewItem == multiagentSetupGh", "group": "inline" },
        { "command": "multiagentSystem.setup.retryCodex", "when": "view == multiagentSystem.toolsSetupView && viewItem == multiagentSetupCodex", "group": "inline" }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test:unit": "npm run build && node --test \"test/**/*.test.js\" \"out/test/unit/**/*.test.js\"",
    "test:host": "npm run build && node out/test/host/runTest.js",
    "test": "npm run check && npm run test:unit",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
